{
  "name": "insta-loader",
  "version": "1.3.3",
  "description": "Build and validation tooling for the insta-loader userscript.",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check:generated": "node scripts/check-generated.mjs",
    "check:determinism": "node scripts/check-determinism.mjs",
    "check:syntax": "node --check insta-loader.user.js",
    "check:whitespace": "git diff --check",
    "lint": "eslint .",
    "test": "vitest run",
    "test:browser": "playwright test",
    "validate": "npm run build && npm run check:generated && npm run check:determinism && npm run check:syntax && npm run lint && npm run test && npm run test:browser && npm run check:whitespace"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.62.1",
    "esbuild": "0.28.1",
    "eslint": "9.39.5",
    "globals": "17.9.0",
    "jquery": "3.7.1",
    "jsdom": "27.4.0",
    "vitest": "4.1.10"
  }
}
